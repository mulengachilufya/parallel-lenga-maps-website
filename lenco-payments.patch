diff --git a/src/lib/lenco-finalize.ts b/src/lib/lenco-finalize.ts
new file mode 100644
index 0000000..f22f717
--- /dev/null
+++ b/src/lib/lenco-finalize.ts
@@ -0,0 +1,81 @@
+/**
+ * Settle one Lenco payment: ask Lenco what happened, and only if the money
+ * really arrived (right reference, right currency, at least the right
+ * amount) give the person their pass. Safe to call any number of times and
+ * from several places at once (the browser after the widget, the webhook, a
+ * retry): the pass is applied exactly once.
+ */
+import type { SupabaseClient } from '@supabase/supabase-js'
+import { fetchCollection, type LencoConfig } from '@/lib/lenco'
+import { computeGrant } from '@/lib/payments/grant'
+import { sendEmail, paymentVerifiedEmail } from '@/lib/email'
+import { logEvent } from '@/lib/ops/log'
+
+export type FinalizeState = 'granted' | 'already' | 'pending' | 'failed' | 'unknown' | 'error'
+export interface FinalizeResult { state: FinalizeState; message: string; expiresAt?: string | null }
+
+interface LencoRow {
+  id: string; reference: string; user_id: string; user_email: string; user_name: string | null
+  plan: string; product: string; amount_charged: number; currency: string
+  granted_at: string | null; status: string
+}
+
+export async function finalizeLencoPayment(
+  service: SupabaseClient, cfg: LencoConfig, reference: string,
+): Promise<FinalizeResult> {
+  const { data: row } = await service.from('lenco_payments').select('*').eq('reference', reference).maybeSingle<LencoRow>()
+  if (!row) return { state: 'unknown', message: 'We do not know this payment.' }
+  if (row.granted_at) return { state: 'already', message: 'Your pass is already active.' }
+
+  const found = await fetchCollection(reference, cfg)
+  if (!found.ok) {
+    // Not found yet usually means the customer has not finished paying.
+    if (found.notFound) return { state: 'pending', message: 'Waiting for the payment to complete.' }
+    void logEvent('warn', 'payments', 'lenco_lookup_failed', 'Could not ask Lenco about a payment.', { reference, error: found.error })
+    return { state: 'error', message: 'Could not reach the payment provider. We will keep trying, check your dashboard shortly.' }
+  }
+
+  const c = found.data
+  if (c.reference !== reference) {
+    return { state: 'error', message: 'Payment reference did not match.' }
+  }
+  if (c.status === 'failed') {
+    await service.from('lenco_payments').update({ status: 'failed', failure_reason: c.reasonForFailure ?? null, lenco_id: c.id }).eq('id', row.id).is('granted_at', null)
+    return { state: 'failed', message: c.reasonForFailure || 'The payment did not go through.' }
+  }
+  if (c.status !== 'successful') {
+    return { state: 'pending', message: 'Waiting for the payment to be confirmed.' }
+  }
+
+  // Money arrived. Is it what we asked for? Never grant for less.
+  const paid = Number(c.amount)
+  if (c.currency !== row.currency || !Number.isFinite(paid) || paid + 0.005 < Number(row.amount_charged)) {
+    await service.from('lenco_payments').update({ status: 'mismatch', lenco_id: c.id, lenco_reference: c.lencoReference, failure_reason: `Paid ${c.amount} ${c.currency}, expected ${row.amount_charged} ${row.currency}` }).eq('id', row.id).is('granted_at', null)
+    void logEvent('critical', 'payments', 'lenco_amount_mismatch', 'A Lenco payment came in for the wrong amount. No access was given.', { reference, paid: c.amount, currency: c.currency, expected: row.amount_charged, expectedCurrency: row.currency })
+    return { state: 'failed', message: 'The amount paid did not match. Please contact support with your reference.' }
+  }
+
+  // Claim it. Only one caller can flip granted_at from null, so a second
+  // caller gets nothing back and stops here instead of granting twice.
+  const now = new Date().toISOString()
+  const { data: claimed } = await service.from('lenco_payments')
+    .update({ status: 'successful', granted_at: now, completed_at: now, lenco_id: c.id, lenco_reference: c.lencoReference, paid_type: c.type })
+    .eq('id', row.id).is('granted_at', null).select('id').maybeSingle()
+  if (!claimed) return { state: 'already', message: 'Your pass is already active.' }
+
+  const { data: current } = await service.from('profiles')
+    .select('plan, plan_status, plan_expires_at, updates_until').eq('id', row.user_id).maybeSingle()
+  const { changes, expiresAt } = computeGrant({ plan: row.plan, product: row.product, account_type: undefined }, current)
+
+  const { error: profErr } = await service.from('profiles').update(changes).eq('id', row.user_id)
+  if (profErr) {
+    // Release the claim so a retry can apply it, and tell the owner loudly.
+    await service.from('lenco_payments').update({ status: 'paid_unapplied', granted_at: null }).eq('id', row.id)
+    void logEvent('critical', 'payments', 'lenco_grant_failed', 'A customer paid through Lenco but their access could not be applied.', { reference, error: profErr.message })
+    return { state: 'error', message: 'Your payment went through but activation hit a problem. We have been alerted and will fix it, you will not be charged twice.' }
+  }
+
+  void sendEmail(paymentVerifiedEmail(row.user_email, row.user_name, row.plan, expiresAt), 'payments')
+  void logEvent('info', 'payments', 'lenco_paid', 'An instant Lenco payment was confirmed and access granted.', { reference, product: row.product, channel: c.type })
+  return { state: 'granted', message: 'Payment confirmed. Your pass is active.', expiresAt }
+}
