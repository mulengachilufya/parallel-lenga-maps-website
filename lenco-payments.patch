+++ b/supabase/migrations/062_lenco_payments.sql
@@ -0,0 +1,48 @@
+-- 062_lenco_payments.sql
+--
+-- Instant payments through Lenco (card, and Airtel/MTN mobile money).
+-- One row per payment ATTEMPT, created by /api/payments/lenco/init before the
+-- customer sees the Lenco widget, and settled by /api/payments/lenco/verify
+-- or the Lenco webhook once Lenco confirms the money.
+--
+-- Manual payments (bank, Airtel, MTN with a screenshot) stay in
+-- manual_payments exactly as they were.
+--
+-- Safety rules this table supports:
+--   * amount_charged and currency are decided by OUR server, never the browser,
+--     and are compared with what Lenco says was paid before access is given.
+--   * granted_at is set by one atomic update, so a payment is applied once even
+--     if the browser, the webhook and a retry all arrive together.
+--
+-- Only the server (service role) reads or writes this table: RLS is on and
+-- there are deliberately no policies.
+--
+-- RUN ONCE in: Supabase Dashboard -> SQL Editor. Run BEFORE deploying the code.
+
+create table if not exists lenco_payments (
+  id              uuid primary key default gen_random_uuid(),
+  reference       text not null unique,
+  user_id         uuid not null references profiles(id) on delete cascade,
+  user_email      text not null,
+  user_name       text,
+  plan            text not null default 'individual',
+  product         text not null,
+  amount_usd      numeric(10,2) not null,
+  amount_charged  numeric(12,2) not null,
+  currency        text not null,
+  channel         text not null check (channel in ('card', 'mobile-money')),
+  status          text not null default 'pending'
+                  check (status in ('pending', 'successful', 'failed', 'mismatch', 'paid_unapplied')),
+  lenco_id        text,
+  lenco_reference text,
+  paid_type       text,
+  failure_reason  text,
+  created_at      timestamptz not null default now(),
+  completed_at    timestamptz,
+  granted_at      timestamptz
+);
+
+create index if not exists lenco_payments_user_idx   on lenco_payments (user_id, created_at desc);
+create index if not exists lenco_payments_status_idx on lenco_payments (status, created_at desc);
+
+alter table lenco_payments enable row level security;
