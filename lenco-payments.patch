+/**
+ * The ways to pay for an Individual pass. Safe to import from the browser:
+ * nothing secret lives here (secrets are read from env in src/lib/lenco.ts).
+ *
+ *   Instant (through Lenco):  card, mobile-money
+ *   Manual (admin verifies):  bank, airtel, mtn
+ */
+export type PayMethod = 'card' | 'mobile-money' | 'bank' | 'airtel' | 'mtn'
+
+export const INSTANT_METHODS: PayMethod[] = ['card', 'mobile-money']
+export const MANUAL_METHODS:  PayMethod[] = ['bank', 'airtel', 'mtn']
+
+/**
+ * Countries where Lenco can collect Airtel / MTN mobile money. This list is
+ * only used to decide whether to SHOW the option to a signed-in person whose
+ * profile country is known; Lenco itself decides what actually works.
+ * Edit it when Lenco opens a new country.
+ */
+export const LENCO_MOBILE_MONEY_COUNTRIES = ['Zambia', 'Malawi'] as const
+
+export function mobileMoneyAvailableIn(country: string | null | undefined): boolean {
+  if (!country) return true // unknown country: show it, Lenco will refuse if unsupported
+  return LENCO_MOBILE_MONEY_COUNTRIES.some((c) => c.toLowerCase() === country.trim().toLowerCase())
+}
+
+export const METHOD_LABEL: Record<PayMethod, { title: string; sub: string; instant: boolean }> = {
+  'card':         { title: 'Card',            sub: 'Mastercard or Visa',            instant: true },
+  'mobile-money': { title: 'Mobile money',    sub: 'Airtel or MTN, paid instantly', instant: true },
+  'bank':         { title: 'Bank transfer',   sub: 'We verify within 24 hours',     instant: false },
+  'airtel':       { title: 'Airtel Money',    sub: 'Send it, upload a screenshot',  instant: false },
+  'mtn':          { title: 'MTN MoMo',        sub: 'Send it, upload a screenshot',  instant: false },
+}
diff --git a/src/lib/payments/grant.ts b/src/lib/payments/grant.ts
new file mode 100644
index 0000000..5a53ffe
--- /dev/null
+++ b/src/lib/payments/grant.ts
@@ -0,0 +1,98 @@
+/**
+ * Granting access after a payment is confirmed.
+ *
+ * ONE place decides what a paid product does to a profile, so every way of
+ * paying ends the same way: an admin approving a manual payment
+ * (/api/admin/payments/verify) and Lenco confirming an instant payment
+ * (src/lib/lenco-finalize.ts) both call computeGrant().
+ *
+ * computeGrant is a PURE function (no database, no network): it takes the
+ * current profile and the payment and returns what to write. That makes it
+ * easy to test, see scripts-free checks in the PR notes.
+ */
+import { PASSES, UPDATE_MONTHS, accessExpiry, isPassProduct } from '@/lib/pricing'
+
+export interface CurrentProfile {
+  plan:            string | null
+  plan_status:     string | null
+  plan_expires_at: string | null
+  updates_until:   string | null
+}
+
+export interface GrantInput {
+  plan:         string                 // 'individual' | 'team'
+  product:      string | null          // 'pass_1m' ... or a legacy product
+  account_type: string | null | undefined
+}
+
+export interface GrantResult {
+  /** Columns to write to profiles. */
+  changes:   Record<string, unknown>
+  /** When the access ends, or null for no end date. Used in the email. */
+  expiresAt: string | null
+}
+
+export function computeGrant(
+  payment: GrantInput,
+  current: CurrentProfile | null | undefined,
+  now: Date = new Date(),
+): GrantResult {
+  // Access for good: an active plan with no end date (the old licence and
+  // earlier plans). These accounts are never given an end date.
+  const permanent = current?.plan_status === 'active' && !current.plan_expires_at
+  const product = payment.product
+
+  if (isPassProduct(product)) {
+    const months = PASSES[product].months
+    if (permanent && current?.plan === 'individual') {
+      // Holds access for good. A pass buys more months of new datasets; with
+      // no limit already, there is nothing to extend.
+      return {
+        expiresAt: null,
+        changes: current.updates_until
+          ? { updates_until: accessExpiry(current.updates_until, months, now), pending_plan: null }
+          : { pending_plan: null },
+      }
+    }
+    const expiresAt = accessExpiry(current?.plan_expires_at, months, now)
+    return {
+      expiresAt,
+      changes: {
+        plan: 'individual', account_type: payment.account_type, plan_status: 'active',
+        plan_expires_at: expiresAt, expiry_reminder_sent_at: null, pending_plan: null,
+        updates_until: null,
+      },
+    }
+  }
+
+  if (product === 'updates') {
+    return {
+      expiresAt: null,
+      changes: { updates_until: accessExpiry(current?.updates_until, UPDATE_MONTHS, now), pending_plan: null },
+    }
+  }
+
+  if (product === 'licence') {
+    // Someone with permanent access from an earlier plan already has
+    // everything with no limit; buying again leaves that alone.
+    const unlimited = permanent && !current?.updates_until && current?.plan === 'individual'
+    return {
+      expiresAt: null,
+      changes: {
+        plan: 'individual', account_type: payment.account_type, plan_status: 'active',
+        plan_expires_at: null, expiry_reminder_sent_at: null, pending_plan: null,
+        updates_until: unlimited ? null : accessExpiry(current?.updates_until, UPDATE_MONTHS, now),
+      },
+    }
+  }
+
+  // Older rows with no product (time-limited plans): 3 months as before.
+  const expiresAt = permanent ? null : accessExpiry(current?.plan_expires_at, undefined, now)
+  return {
+    expiresAt,
+    changes: {
+      plan: payment.plan, account_type: payment.account_type, plan_status: 'active',
+      plan_expires_at: expiresAt, expiry_reminder_sent_at: null, pending_plan: null,
+    },
+  }
+}
diff --git a/supabase/migrations/062_lenco_payments.sql b/supabase/migrations/062_lenco_payments.sql
