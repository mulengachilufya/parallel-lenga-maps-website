# Supabase — get from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 — get from Cloudflare Dashboard > R2 > Manage R2 API Tokens
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=gis-data-lenga-maps

# Web3Forms — powers email notifications (contact form + manual payment alerts)
# Free key from https://web3forms.com — enter lengamaps@gmail.com as the destination
NEXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key

# Email — ALL automated mail goes through Resend (no SMTP, no Web3Forms).
# Verify lengamaps.com in Resend, then create one API key per channel and
# scope each to its sender address in the Resend dashboard. Real values live
# in Vercel (and in your git-ignored .env.local) — NEVER paste them here.
#
# Newsletter mail — sends from newsletter@lengamaps.com
RESEND_NEWSLETTER_API_KEY=re_your-newsletter-key
# Resend Audience id that backs the weekly newsletter (Resend > Broadcasts).
# New subscribers are auto-added to it. Create an Audience in Resend and paste
# its id here. Not a secret.
RESEND_AUDIENCE_ID=your-resend-audience-id
# New-account lifecycle (welcome, trial-ended, nudge) — from support@lengamaps.com
RESEND_NEW_USER_API_KEY=re_your-new-user-key
# Payments (confirmation, receipt, failure) — from support@lengamaps.com
RESEND_PAYMENTS_API_KEY=re_your-payments-key


# CRON_SECRET — protects the cron endpoints. Vercel Cron sends this
# automatically as `Authorization: Bearer <CRON_SECRET>`. Generate any long
# random string and set it in Vercel project settings.
# CRON_SECRET=your-long-random-secret

# Admin allow-list — comma-separated emails that can access /admin/* and
# approve/reject manual payments. Server-side only (no NEXT_PUBLIC_ prefix).
ADMIN_EMAILS=lengamaps@gmail.com,cmulenga672@gmail.com

# Lipila — payment provider
# LIPILA_API_KEY=your-lipila-api-key
# LIPILA_SANDBOX=false
#
# HMAC secret from the Lipila dashboard. REQUIRED in production — unset only
# in local dev. When set, /api/payments/webhook verifies signatures and
# rejects unsigned/forged callbacks with 401.
# LIPILA_WEBHOOK_SECRET=base64-secret-from-lipila-dashboard
#
# Temporary capture switch: set to "true" only while you are still
# discovering Lipila's exact signature header name. The webhook logs every
# header on each call — once you confirm the header, REMOVE this var and
# the route becomes strict (rejects unsigned callbacks). Leaving this on
# in production means anyone who knows your reference IDs can forge a
# successful payment.
# LIPILA_WEBHOOK_ALLOW_UNSIGNED=false

# CallMeBot WhatsApp — optional: sends manual-payment alerts to your WhatsApp.
# One-time setup:
#   1. Add +34 644 59 71 67 to your contacts
#   2. From the phone below, WhatsApp that contact: "I allow callmebot to send me messages to this number"
#   3. You receive an API key reply — paste it below
# Leave blank to disable WhatsApp notifications (email still fires).
CALLMEBOT_WHATSAPP_PHONE=260965699359
CALLMEBOT_WHATSAPP_APIKEY=
